# Gateway Debt Help — pillar site redirects
# No legacy slugs to migrate yet. Keep in sync with sitemap.xml as pages are added.

# Blog list
/blogs                     /blog                                           301
/blogs/                    /blog/                                          301
/blog                      /blog.index.html                                200
/blog/                     /blog.index.html                                200
/blog/index                /blog.index.html                                200
/blog/index.html           /blog.index.html                                200

# Blog article HTML files should resolve as-is.
/blog/*.html                                      /blog/:splat                                   200

# Extensionless pretty slugs should resolve to the static blog HTML files.
# This keeps the visible URL on /blog/<slug> while serving /blog/<slug>.html.
/blog/*/                                          /blog/:splat.html                              200
/blog/*                                           /blog/:splat.html                              200

# Legacy paths → new location
/content/blog/:year-:month-:day-:rest                 /blog/:year-:month-:day-:rest.html                     301
/content/blog/:splat                                  /blog/:splat                                           301
