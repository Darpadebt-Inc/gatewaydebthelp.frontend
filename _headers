# === Unified security + performance baseline (network-wide parity with DRG/DHF) ===
# Content-Security-Policy is deployed in Report-Only mode first: it captures violations
# without blocking any revenue-critical payload, so lead-gen uptime is unaffected while
# the allowlist is validated against real traffic. This site loads no external scripts
# beyond its own lead-router API, so the allowlist is minimal.
/*
  Content-Security-Policy-Report-Only: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'unsafe-inline'; connect-src 'self'; form-action 'self'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: no-cache, must-revalidate
  Vary: Accept, Origin

/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

# eng038 ships under a fixed filename; keep it updatable (the generic /*.js rule
# above would freeze it in browser caches for a year). ab015.client versions via
# its filename and keeps the immutable rule.
/eng038.sitewide.js
  Cache-Control: public, max-age=3600

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.ico
  Cache-Control: public, max-age=31536000, immutable

# Blog JSON list should never be cached between requests
/blogs.json
  Cache-Control: no-store, must-revalidate
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, OPTIONS

/blog.index.html
  Cache-Control: no-cache, must-revalidate

# All generated blog HTML should be publicly cacheable but CORS-accessible
/blog/*.html
  Cache-Control: public, max-age=600
  Vary: Accept, Origin
  Access-Control-Allow-Origin: *

# Blog folder (covers generated HTML + assets in /blog)
/blog/*
  Cache-Control: public, max-age=300
  Access-Control-Allow-Origin: *

/content/blog/*
  Cache-Control: public, max-age=300
